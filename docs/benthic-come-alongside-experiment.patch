+    /** The spot alongside the owner it comes up to, on its side, a little ahead of where they'll be. */
+    private Vec closeSpot(OwnerState o) {
+        Vec lead = o.velocity().horizontal().scale(0.3);
+        return ownerFloor.add(o.flatRight().scale(0.75 * closeSide)).add(o.flatForward().scale(0.3)).add(lead);
+    }
+
+    /**
+     * Whether it can walk straight up alongside. Behind a pillar it can't, and walking at the spot
+     * held it against the pillar for good; then it follows the way to its owner as usual instead.
+     */
+    private boolean closeWalkable(OwnerState o, LocalVoxels v) {
+        if ((feetMode & WALKABLE) == 0) return true;
+        Vec spot = closeSpot(o);
+        double floor = g.footprintFloorFrom(v, spot.x(), spot.z(), g.floorY);
+        return !Double.isNaN(floor) && walkable(v, g.pos, new Vec(spot.x(), floor, spot.z()));
+    }
+
+    /** Diagnostics: which parts of coming alongside round the feet are on (§19), as flags. */
+    static final int TANGENT = 1, STOP_GUARD = 2, TURN_CAP = 4, WALKABLE = 8;
+    static int feetMode = Integer.parseInt(System.getProperty("tweakA", "0"));
+
+    /** Clearance kept from the owner's feet on the way alongside, beyond its own radius, blocks. */
+    static final double FEET_CLEAR = 0.35;
+
+    /**
+     * The way to {@code target} round the owner's feet: where the straight walk would cross them,
+     * along the tangent to a circle round their feet, on the side nearer the target. Re-taken every
+     * tick, so it slides round the rim and never parks at a fixed detour point.
+     */
+    private Vec roundFeet(Vec target, LocalVoxels v) {
+        Vec c = ownerFloor, p = g.pos;
+        double r = g.radius + FEET_CLEAR;
+        Vec leg = target.sub(p).horizontal();
+        double l2 = leg.lengthSqr();
+        if (l2 < 1e-9) return target;
+        Vec pc = c.sub(p).horizontal();
+        double along = pc.dot(leg) / l2;
+        if (along <= 0 || along >= 1 || horizontal(p.add(leg.scale(along)), c) >= r) return target;
+        double d = pc.length();
+        Vec legDir = leg.scale(1 / Math.sqrt(l2));
+        if (d <= r + 0.05) {
+            // On the rim or inside it: out and round, toward the target's side.
+            Vec out = d > 1e-6 ? pc.scale(-1 / d) : new Vec(-legDir.z(), 0, legDir.x());
+            Vec tan = new Vec(-out.z(), 0, out.x());
+            if (tan.dot(legDir) < 0) tan = tan.scale(-1);
+            Vec dir = out.add(tan).normalize();
+            Vec rim = new Vec(c.x() + dir.x() * (r + 0.15), target.y(), c.z() + dir.z() * (r + 0.15));
+            return (feetMode & WALKABLE) != 0 && !walkable(v, g.pos, rim) ? target : rim;
+        }
+        double a = Math.asin(r / d), len = Math.sqrt(d * d - r * r) + 0.3;
+        Vec u = pc.scale(1 / d);
+        Vec best = null;
+        double bestScore = 0;
+        for (double sgn : new double[] {1, -1}) {
+            double cs = Math.cos(sgn * a), sn = Math.sin(sgn * a);
+            Vec dir = new Vec(u.x() * cs - u.z() * sn, 0, u.x() * sn + u.z() * cs);
+            // Round the side the target lies on: its direction is the nearer to the target's.
+            Vec tip = p.add(dir.scale(len));
+            double score = -horizontal(tip, target);
+            if (best == null || score > bestScore) {
+                bestScore = score;
+                best = tip;
+            }
+        }
+        Vec tip = new Vec(best.x(), target.y(), best.z());
+        // Never round into a pillar: a tip it can't walk to would hold it there for good.
+        return (feetMode & WALKABLE) != 0 && !walkable(v, g.pos, tip) ? target : tip;
+    }
