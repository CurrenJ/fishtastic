@@ -0,0 +1,160 @@
+package grill24.fishsim.companion;
+
+import grill24.fishsim.harness.companion.CompanionRun;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
+
+import java.util.List;
+
+/**
+ * Diagnostic for coming alongside round the owner's feet (docs/fish-companions-benthic-follow.md
+ * §19): {@link GroundMind#feetMode} variants against mode 0 on equal seeds. Run with -PsimStdout;
+ * {@code -PsweepSeeds=20}, {@code -Psweep=0,3} (modes), {@code -Ptrace=script} to run one script.
+ */
+@EnabledIfSystemProperty(named = "simStdout", matches = "true")
+class ComeAlongsideProbe {
+
+    record Cfg(String script, float length) {}
+
+    /** -Ptrace=script -PtracePos=seed -PsweepLength -Psweep=0,4: first divergence, then the longest unseen stretch of the second mode. */
+    @Test
+    void lockstep() {
+        String script = System.getProperty("trace");
+        if (script == null || System.getProperty("tracePos") == null) return;
+        long seed = Long.parseLong(System.getProperty("tracePos"));
+        float length = Float.parseFloat(System.getProperty("sweepLength", "0.3"));
+        String[] modes = System.getProperty("sweep", "0,4").split(",");
+        int saved = GroundMind.feetMode;
+        CompanionRun[] runs = new CompanionRun[2];
+        for (int k = 0; k < 2; k++) {
+            GroundMind.feetMode = Integer.parseInt(modes[k].trim());
+            runs[k] = CompanionRun.benthic(script, seed, length, Temperament.BASELINE, GroundGait.CRAWL,
+                    CompanionTunables.defaults(), true);
+            runs[k].run(2400);
+        }
+        GroundMind.feetMode = saved;
+        int div = -1;
+        for (int i = 0; i < 2400 && div < 0; i++) {
+            if (runs[0].samples.get(i).pos().distanceTo(runs[1].samples.get(i).pos()) > 1e-9) div = i;
+        }
+        System.out.printf("LOCK %s#%d diverge at %d%n", script, seed, div);
+        for (int k = 0; k < 2; k++) {
+            int best = 0, start = 0, cur = 0, bestStart = 0;
+            for (int i = 0; i < 2400; i++) {
+                if (runs[k].samples.get(i).seen()) cur = 0;
+                else if (++cur > best) { best = cur; bestStart = i - cur + 1; }
+            }
+            System.out.printf("LOCK m=%s longest unseen %d..%d%n", modes[k], bestStart, bestStart + best);
+        }
+        int from = Integer.parseInt(System.getProperty("sweepTicks", "-1"));
+        if (from >= 0) {
+            // Tick by tick through the second mode's window, with the agent's own state.
+            GroundMind.feetMode = Integer.parseInt(modes[1].trim());
+            CompanionRun run = CompanionRun.benthic(script, seed, length, Temperament.BASELINE, GroundGait.CRAWL,
+                    CompanionTunables.defaults(), true);
+            for (int i = 0; i < from + 50; i++) {
+                run.tick();
+                if (i < from) continue;
+                CompanionAgent a = run.agent;
+                Vec p = a.position(), f = run.owner.feet();
+                Vec rel = p.sub(f).horizontal();
+                System.out.printf("  T %4d %-12s %-16s close=%-5s in=%-5s fwd %5.2f right %5.2f d %4.2f oyaw %6.1f osp %4.2f target=%s%n",
+                        i, a.landMode(), a.perchState(), a.comingClose(), CompanionRun.insideBody(run.owner, p),
+                        rel.dot(run.owner.flatForward()), rel.dot(run.owner.flatRight()), rel.length(), run.owner.yawDeg(),
+                        run.owner.horizontalSpeed(), a.target());
+            }
+            GroundMind.feetMode = saved;
+            return;
+        }
+        for (int i = Math.max(0, div - 5); i < Math.min(2400, div + 600); i += 10) {
+            for (int k = 0; k < 2; k++) {
+                CompanionRun.Sample s = runs[k].samples.get(i);
+                Vec f = s.owner().feet();
+                System.out.printf("  t=%4d m=%s %-14s %-12s seen=%-5s pos %6.2f %6.2f %6.2f own %6.2f %6.2f %6.2f osp %4.2f d %4.2f%n",
+                        i, modes[k], s.goal(), s.land(), s.seen(), s.pos().x(), s.pos().y(), s.pos().z(), f.x(), f.y(), f.z(),
+                        s.owner().horizontalSpeed(), s.pos().sub(f).horizontalLength());
+            }
+        }
+    }
+
+    /** Every inside-owner tick, by what the agent was doing: -Ptrace=script -PsweepLength -PsweepSeeds -PtweakA=mode. */
+    @Test
+    void classify() {
+        String script = System.getProperty("trace");
+        if (script == null || System.getProperty("tracePos") != null) return;
+        float length = Float.parseFloat(System.getProperty("sweepLength", "0.3"));
+        int seeds = Integer.parseInt(System.getProperty("sweepSeeds", "60"));
+        java.util.Map<String, Integer> counts = new java.util.TreeMap<>();
+        int total = 0;
+        for (int seed = 1; seed <= seeds; seed++) {
+            CompanionRun run = CompanionRun.benthic(script, seed, length, Temperament.BASELINE, GroundGait.CRAWL,
+                    CompanionTunables.defaults(), true);
+            boolean wasClose = false;
+            for (int i = 0; i < 2400; i++) {
+                run.tick();
+                CompanionAgent a = run.agent;
+                boolean close = a.comingClose();
+                if (CompanionRun.insideBody(run.owner, a.position())) {
+                    String state = a.perchState().split(" ")[0];
+                    String key = String.format("%-14s %s owner=%s", state,
+                            close ? "close" : wasClose ? "after-close" : "-", run.owner.horizontalSpeed() > 0.6 ? "moving" : "still");
+                    counts.merge(key, 1, Integer::sum);
+                    total++;
+                }
+                if (close) wasClose = true;
+                if (!a.perchState().startsWith("GROUND")) wasClose = false;
+            }
+        }
+        System.out.printf("CLASS %s len=%.2f mode=%d total=%d%n", script, length, GroundMind.feetMode, total);
+        for (var e : counts.entrySet()) System.out.printf("CLASS   %5d  %s%n", e.getValue(), e.getKey());
+    }
+
+    @Test
+    void ab() {
+        int seeds = Integer.parseInt(System.getProperty("sweepSeeds", "20"));
+        String[] modes = System.getProperty("sweep", "0,3").split(",");
+        String only = System.getProperty("trace");
+        int saved = GroundMind.feetMode;
+        for (Cfg c : List.of(new Cfg("low_ceiling", 0.3f), new Cfg("jumping", 0.3f), new Cfg("walk_flat", 0.3f),
+                new Cfg("walk_meander", 0.3f), new Cfg("stairs_up_down", 0.3f), new Cfg("low_ceiling", 0.6f),
+                new Cfg("jumping", 0.6f), new Cfg("walk_flat", 0.6f), new Cfg("walk_meander", 0.6f),
+                new Cfg("stairs_up_down", 0.6f))) {
+            if (only != null && !only.equals(c.script())) continue;
+            int[] baseSeen = new int[seeds + 1];
+            for (String mode : modes) {
+                GroundMind.feetMode = Integer.parseInt(mode.trim());
+                int fades = 0, leash = 0, insideOver = 0, unseenOver = 0, up = 0, down = 0;
+                long backstops = 0, seenWalk = 0, insideTicks = 0;
+                double inside = 0, unseen = 0;
+                for (int seed = 1; seed <= seeds; seed++) {
+                    CompanionRun run = CompanionRun.benthic(c.script(), seed, c.length(), Temperament.BASELINE,
+                            GroundGait.CRAWL, CompanionTunables.defaults(), true);
+                    run.run(2400);
+                    CompanionRun.Metrics m = run.metrics();
+                    double share = m.insideOwnerTicks() / (double) m.ticks();
+                    fades += (int) run.groundMetrics().fades();
+                    leash += m.leashEvents() > 0 ? 1 : 0;
+                    backstops += m.backstops();
+                    insideTicks += m.insideOwnerTicks();
+                    inside = Math.max(inside, share);
+                    insideOver += share > 0.01 ? 1 : 0;
+                    unseen = Math.max(unseen, m.longestUnseenSeconds());
+                    unseenOver += m.longestUnseenSeconds() > 30 ? 1 : 0;
+                    int sw = 0;
+                    for (CompanionRun.Sample s : run.samples) if (s.owner().horizontalSpeed() > 1 && s.seen()) sw++;
+                    seenWalk += sw;
+                    if (only != null) System.out.printf("  SEED m=%s %-12s #%d unseen %.1fs inside %d walkSeen %d%n",
+                            mode, c.script(), seed, m.longestUnseenSeconds(), m.insideOwnerTicks(), sw);
+                    if (mode.equals(modes[0])) baseSeen[seed] = sw;
+                    else if (sw > baseSeen[seed]) up++;
+                    else if (sw < baseSeen[seed]) down++;
+                }
+                System.out.printf("AB m=%s %-15s len=%.2f inside ticks=%4d max=%.3f runs>1%%=%d | unseen max=%5.1fs runs>30s=%d"
+                                + " | fades=%d leashRuns=%d backstops=%3d | walkSeen=%d (seeds up %d down %d)%n",
+                        mode, c.script(), c.length(), insideTicks, inside, insideOver, unseen, unseenOver,
+                        fades, leash, backstops, seenWalk, up, down);
+            }
+        }
+        GroundMind.feetMode = saved;
+    }
+}
