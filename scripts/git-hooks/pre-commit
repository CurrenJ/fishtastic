#!/bin/sh
# Blocks the commit if the common unit tests or either loader's game tests fail.

echo ""
echo "=== Pre-commit: running unit tests ==="

if ! ./gradlew :common:test :tools:tank-shape-gen:test; then
    echo ""
    echo "COMMIT BLOCKED: unit tests failed."
    exit 1
fi

echo ""
echo "=== Pre-commit: running game tests ==="

echo "--- Fabric ---"
if ! ./gradlew :fabric:runGametest; then
    echo ""
    echo "COMMIT BLOCKED: Fabric game tests failed."
    exit 1
fi

echo ""
echo "NeoForge game tests skipped (runGametest occasionally hangs on this loader)."
echo ""
echo "All game tests passed."
